# Copier ce fichier en .env.local et remplir les valeurs (ne jamais commiter .env.local)

# Firebase : Console > Paramètres du projet > Vos applications > Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# EmailJS : Email Services, Email Templates, Account > Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Facultatif : modèle des suggestions (« Une idée, une demande ? »), adressé à l'équipe dans EmailJS
VITE_EMAILJS_FEEDBACK_TEMPLATE_ID=

# true = utiliser les émulateurs locaux (npm run emulators), false = le vrai projet Firebase
VITE_USE_EMULATORS=true
