rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['displayName', 'email', 'preferredLanguage', 'timezone',
                                  'welcomeEmailSent', 'onboardingCompleted', 'createdAt', 'updatedAt'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 50
        && data.email is string
        && data.preferredLanguage in ['fr', 'ar']
        && data.timezone is string
        && data.welcomeEmailSent is bool
        && data.onboardingCompleted is bool
        && data.createdAt is timestamp;
    }

    // Profil de la maman : seule la propriétaire y a accès (cahier §28)
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.welcomeEmailSent == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // Les sous-collections (babies, appointments...) seront ouvertes module par module.
    }

    // Tout le reste est refusé par défaut.
  }
}
